{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "analysis.json of a sceptre analysis folder (SPEC.md, A1)",
  "type": "object",
  "required": [
    "format",
    "response_modality",
    "screen"
  ],
  "properties": {
    "format": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "response_modality": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "not": {
        "const": "grna"
      }
    },
    "screen": {
      "type": "object",
      "required": [
        "id",
        "format",
        "n_cells",
        "n_responses",
        "n_grnas",
        "cell_ids_sha256",
        "response_ids_sha256",
        "grna_ids_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "$comment": "The data file's perturb_seq_format when the analysis was created. Recorded, not part of the identity a reader checks."
        },
        "n_cells": {
          "type": "integer",
          "minimum": 0
        },
        "n_responses": {
          "type": "integer",
          "minimum": 0
        },
        "n_grnas": {
          "type": "integer",
          "minimum": 0
        },
        "cell_ids_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_ids_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "grna_ids_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
          "type": "string",
          "pattern": "^(https?://[^\\s]+|(?![/~])(?![A-Za-z]:)(?!.*://)[^\\\\]+)$",
          "$comment": "A hint: a relative POSIX path or an http(s) URL. Never an absolute local path."
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
