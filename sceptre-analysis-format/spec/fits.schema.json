{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The identity of the fits in one part file of fits/response/: how they were made. It is JSON text under the key `sceptre_fit_identity` in the part's Parquet key-value metadata (SPEC.md, A13)",
  "type": "object",
  "required": [
    "screen_id",
    "formula",
    "cells_in_use_sha256",
    "control_group"
  ],
  "properties": {
    "screen_id": {
      "type": "string",
      "minLength": 1
    },
    "formula": {
      "type": "string",
      "pattern": "^~"
    },
    "cells_in_use_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "control_group": {
      "enum": [
        "complement",
        "nt_cells"
      ]
    }
  }
}
