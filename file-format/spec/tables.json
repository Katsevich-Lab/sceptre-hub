          "name": "grna_id",
          "type": "string",
          "required": false,
          "present_under": [
            "singleton",
            "bonferroni"
          ],
          "rule": "T3.3"
        },
        {
          "name": "response_id",
          "type": "string",
          "required": true
        },
        {
          "name": "pass_qc",
          "type": "boolean",
          "required": true
        }
      ]
    },
    {
      "name": "qc/positive_control_pair_qc",
