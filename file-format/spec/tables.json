    },
    {
      "name": "assignment/flagged_cells",
      "stage": "assignment",
      "required": false,
      "key": [
        "cell_id"
      ],
      "extra_columns": "ignored",
      "columns": [
        {
          "name": "cell_id",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "qc/cells",
      "stage": "qc",
      "required": true,
      "key": [
        "cell_id"
      ],
      "extra_columns": "ignored",
      "columns": [
        {
          "name": "cell_id",
          "type": "string",
          "required": true
        },
        {
          "name": "in_use",
          "type": "boolean",
          "required": true
        }
      ]
    },
    {
      "name": "qc/discovery_pair_qc",
