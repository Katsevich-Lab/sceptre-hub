{
  "$comment": "The tables of a sceptre analysis folder. Both prototype libraries and both validators read this file. SPEC.md sections T0 to T6 are the rules; this file is their machine-readable form. A table's name is its path in the analysis folder, without `.parquet`.",
  "format": "0.1",
  "stages": [
    "parameters",
    "assignment",
    "qc",
    "calibration",
    "power",
    "discovery"
  ],
  "stage_rank": {
    "parameters": 1,
    "assignment": 2,
    "qc": 3,
    "calibration": 4,
    "power": 4,
    "discovery": 4
  },
  "max_rows_per_row_group": 1000000,
  "column_types": {
    "string": "UTF-8 text, plain or dictionary-encoded; never missing",
    "boolean": "Parquet boolean; never missing",
    "double": "64-bit float; may be missing where `nullable` is true",
    "list<double>": "a list of 64-bit floats per row"
  },
  "fields": {
    "stage": "the stage that writes the table, which is also the folder it is in; null for the fit cache, which no stage owns",
    "required": "whether the table must exist once its stage has run",
    "key": "the key columns, in sort order; a key column that is not required is part of the key when it is present",
    "extra_columns": "`ignored`: a reader takes only the columns listed. `kept`: a reader keeps further columns (diagnostics)",
    "one_of": "groups of columns of which at least one must be present",
    "present_under": "on a column: the gRNA integration strategies under which the column is present; under any other strategy it is absent",
    "forbidden_columns": "columns the table must not have",
    "unique_across_parts": "false where two part files may hold the same key (the fit cache); a reader then takes either row"
  },
  "tables": [
    {
      "name": "parameters/discovery_pairs",
      "stage": "parameters",
      "required": true,
      "key": [
        "grna_target",
        "response_id"
      ],
      "extra_columns": "ignored",
      "columns": [
        {
          "name": "grna_target",
          "type": "string",
          "required": true
        },
        {
          "name": "response_id",
          "type": "string",
          "required": true
        }
      ]
    },
    {
