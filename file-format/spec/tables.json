          "required": true
        },
        {
          "name": "response_id",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "assignment/assignments",
      "stage": "assignment",
      "required": true,
      "key": [
        "grna_id",
        "cell_id"
      ],
