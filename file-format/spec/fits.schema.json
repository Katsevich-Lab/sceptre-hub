{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fits/response/identity.json: how the cached response fits were made (SPEC.md, T6)",
  "type": "object",
  "required": [
    "screen_id",
    "formula",
    "cells_in_use_sha256",
    "response_fit_method",
    "control_group"
  ],
  "properties": {
    "screen_id": {
      "type": "string",
      "minLength": 1
    },
    "formula": {
      "type": "string",
      "pattern": "^~"
    },
    "cells_in_use_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "response_fit_method": {
      "type": "string"
    },
    "control_group": {
      "enum": [
        "complement",
        "nt_cells"
      ]
    }
  }
}
