{
  "$comment": "The structure of a sceptre data file, format 0, as data. Both validators read this file. SPEC.md section 2 states the rules; rules that need computing (order of cells within a feature, uniqueness, the same cells in every modality) are code in each language.",
  "format": "0.1",
  "root": {
    "encoding-type": "MuData"
  },
  "modalities": {
    "grna": "grna",
    "minimum": 2,
    "name_pattern": "^[A-Za-z][A-Za-z0-9_]*$"
  },
  "counts": {
    "encoding-type": "csc_matrix",
    "arrays": {
      "data": "int32",
      "indices": "index",
      "indptr": "index"
    },
    "index": {
      "$comment": "The one type of both index arrays (S4.2, S4.3). It is `narrow` while the largest of the number of stored values, the number of cells and the number of features is at most `narrow_up_to`, and `wide` beyond. This is the type scipy chooses for a sparse matrix of that size.",
      "narrow": "int32",
      "wide": "int64",
      "narrow_up_to": 2147483647
    },
    "rules": {
      "data": "S4.1",
      "indices": "S4.2",
      "indptr": "S4.3"
    },
    "filters": [
      "deflate",
      "shuffle"
    ]
  },
  "storage_kinds": {
    "double": "an `array` of 64-bit floats",
    "int32": "an `array` of 32-bit signed integers, with no missing value",
    "categorical": "an AnnData `categorical` with text categories",
    "string": "an AnnData `string-array`"
  },
  "cell_tables": {
    "column_kinds": [
      "double",
      "int32",
      "categorical"
    ],
    "column_name_pattern": "^[A-Za-z][A-Za-z0-9_.]*$",
    "every_modality": [
      {
        "name": "n_umis",
        "kinds": [
          "double",
          "int32"
        ],
        "required": true
      },
      {
        "name": "n_nonzero",
        "kinds": [
          "double",
          "int32"
        ],
        "required": true
      },
      {
        "name": "p_mito",
        "kinds": [
          "double",
          "int32"
        ],
        "required": false
      }
    ]
  },
  "feature_tables": {
    "column_kinds": [
      "double",
      "int32",
      "categorical",
      "string"
    ]
  },
  "grna_table": [
    {
      "name": "grna_target",
      "kinds": [
        "string",
        "categorical"
      ],
      "required": true,
      "rule": "S8.1"
    },
    {
      "name": "target_chr",
      "kinds": [
        "string",
        "categorical"
      ],
      "required": false,
      "rule": "S8.2"
    },
    {
      "name": "target_start",
      "kinds": [
        "double",
        "int32"
      ],
      "required": false,
      "rule": "S8.2"
    },
    {
      "name": "target_end",
      "kinds": [
        "double",
        "int32"
      ],
      "required": false,
      "rule": "S8.2"
    },
    {
      "name": "vector_id",
      "kinds": [
        "string",
        "categorical"
      ],
      "required": false,
      "no_missing": true,
      "rule": "S8.6"
    }
  ],
  "metadata": {
    "path": "uns/sceptre",
    "entries": {
      "format": {
        "kind": "string",
        "pattern": "^[0-9]+\\.[0-9]+$",
        "required": true
      },
      "moi": {
        "kind": "string",
        "values": [
          "high",
          "low"
        ],
        "required": true
      },
      "id": {
        "kind": "string",
        "required": true
      },
      "name": {
        "kind": "string",
        "required": false
      },
      "source": {
        "kind": "string",
        "required": false
      },
      "perturbation_type": {
        "kind": "string",
        "required": false,
        "values": [
          "CRISPRko",
          "CRISPRi",
          "CRISPRa",
          "CRISPRbe",
          "CRISPRkd"
        ]
      },
      "organism": {
        "kind": "string",
        "required": false
      },
      "genome_build": {
        "kind": "string",
        "required": false
      }
    }
  },
  "grna_table_forbidden": [
    {
      "name": "grna_group",
      "rule": "S8.5"
    }
  ]
}
